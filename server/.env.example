DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME
BIND_ADDR=127.0.0.1:8080
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_TTL_HOURS=168
# Comma-separated list of allowed frontend origins, e.g. https://example.com
CORS_ORIGINS=http://localhost:5173
# Set to true in production (HTTPS)
COOKIE_SECURE=false
RUST_LOG=server=info,tower_http=info

# Bookeo (https://www.bookeo.com/api)
BOOKEO_API_KEY=change-me
BOOKEO_SECRET_KEY=change-me
# Business timezone used for "today" and date ranges
BOOKEO_TIMEZONE=Asia/Qatar
# BOOKEO_BASE_URL=https://api.bookeo.com/v2
