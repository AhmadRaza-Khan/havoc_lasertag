DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DB_NAME
BIND_ADDR=127.0.0.1:8080
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_TTL_HOURS=168
# Comma-separated list of allowed frontend origins, e.g. https://example.com
CORS_ORIGINS=http://localhost:5173
# Set to true in production (HTTPS)
COOKIE_SECURE=false
RUST_LOG=server=info,tower_http=info

# Bookeo (https://www.bookeo.com/api)
BOOKEO_API_KEY=change-me
BOOKEO_SECRET_KEY=change-me
# Business timezone used for "today" and date ranges
BOOKEO_TIMEZONE=Asia/Qatar
# BOOKEO_BASE_URL=https://api.bookeo.com/v2

# QNB payment gateway (online payment of app bookings). Leave all unset to turn it off.
# API password and key: "Merchant API Details" in the QNB merchant console.
# QNB_BASE_URL=https://ecommerce-uat.qnb.com
# QNB_USER_ID=
# QNB_MERCHANT_ID=
# QNB_MERCHANT_PWD=
# QNB_MERCHANT_KEY=

# SMTP2GO email (payment emails). Unset = emails are logged, not sent.
# SMTP2GO_API_KEY=
# MAIL_FROM=Havoc Laser Tag <no-reply@your-domain>
